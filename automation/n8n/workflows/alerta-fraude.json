      "parameters": {
        "jsCode": "// El core calcula el puntaje (0–100) y lo publica en el evento; aquí se decide si se pregunta al cliente.\nconst e = $('Verificar firma').first().json.event;\nconst threshold = Number($env.FRAUD_SCORE_THRESHOLD || 60);\nconst risk = e.data.risk || { score: 0, reasons: [] };\nreturn [{ json: { open: risk.score >= threshold, entry_id: e.data.entry_id, score: risk.score, reasons: risk.reasons, threshold } }];\n"
      },
