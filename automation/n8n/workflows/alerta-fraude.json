    {
      "parameters": {
        "jsCode": "const EXPECTED_TYPES = [\"transfer.posted\"];\n// Verifica Ambar-Signature: t=<unix>,v1=<hex(hmac-sha256(secreto, t + \".\" + cuerpo))>.\n// Se firma el cuerpo crudo: volver a serializar el JSON podría cambiar bytes y romper la firma.\n// WEBHOOK_SIGNING_SECRET admite varios secretos separados por coma (rotación sin corte).\nconst crypto = require('crypto');\nconst item = $input.first();\nconst secrets = String($env.WEBHOOK_SIGNING_SECRET || '').split(',').map((s) => s.trim()).filter(Boolean);\nconst header = String((item.json.headers || {})['ambar-signature'] || '');\n\nlet raw = '';\ntry {\n  raw = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\n} catch (err) {\n  raw = item.binary && item.binary.data ? Buffer.from(item.binary.data.data, 'base64').toString('utf8') : '';\n}\n\nlet t = NaN;\nconst v1 = [];\nfor (const part of header.split(',')) {\n  const i = part.indexOf('=');\n  if (i < 0) continue;\n  const k = part.slice(0, i).trim();\n  const v = part.slice(i + 1).trim();\n  if (k === 't') t = Number(v);\n  else if (k === 'v1' && /^[0-9a-f]{64}$/.test(v)) v1.push(v);\n}\n\nlet valid = false;\nlet reason = 'MISMATCH';\nconst now = Math.floor(Date.now() / 1000);\nif (secrets.length === 0) reason = 'NO_SECRET';\nelse if (!Number.isInteger(t) || v1.length === 0) reason = 'MALFORMED';\nelse if (Math.abs(now - t) > 300) reason = 'EXPIRED';\nelse {\n  for (const secret of secrets) {\n    const expected = crypto.createHmac('sha256', secret).update(`${t}.${raw}`).digest();\n    const match = v1.some((c) => {\n      const given = Buffer.from(c, 'hex');\n      return given.length === expected.length && crypto.timingSafeEqual(given, expected);\n    });\n    if (match) {\n      valid = true;\n      break;\n    }\n  }\n}\n\nlet event = null;\nif (valid) {\n  try {\n    event = JSON.parse(raw);\n  } catch (err) {\n    valid = false;\n    reason = 'MALFORMED';\n  }\n}\nif (valid && !EXPECTED_TYPES.includes(event.type)) {\n  valid = false;\n  reason = 'UNEXPECTED_TYPE';\n}\nreturn [{ json: { valid, reason: valid ? null : reason, event } }];\n"
      },
