    {
      "parameters": {
        "jsCode": "// Push por Expo. Por privacidad, el texto del push es genérico salvo PUSH_SHOW_DETAILS=true:\n// en la pantalla bloqueada no se muestran montos. El detalle está en la bandeja de la app.\n// Solo se envía cuando el aviso se creó en esta ejecución (created): un reintento no repite el push.\nconst enabled = String($env.PUSH_ENABLED || 'false') === 'true';\nconst details = String($env.PUSH_SHOW_DETAILS || 'false') === 'true';\nconst messages = [];\nfor (const item of $input.all()) {\n  const r = item.json;\n  if (!r.created) continue;\n  for (const to of r.push_tokens || []) {\n    messages.push({\n      to,\n      title: details ? r.notification.title : 'Ámbar',\n      body: details ? r.notification.body : 'Tienes un aviso nuevo. Abre la app para verlo.',\n      data: { notification_id: r.notification.id, kind: r.notification.kind, ...r.notification.data },\n      sound: 'default',\n      priority: 'high',\n    });\n  }\n}\nreturn [{ json: { send: enabled && messages.length > 0, count: messages.length, messages } }];\n"
      },
