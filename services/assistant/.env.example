# Asistente en local: modelo guionado (sin AWS) contra el Ledger local.
LOCAL_JWT_SECRET=local-dev-secret-que-tiene-al-menos-32-caracteres
CORE_API_URL=http://localhost:3000
PORT=3002
MODEL_PROVIDER=scripted
CONVERSATION_STORE=memory

# Con Bedrock desde tu máquina (credenciales de AWS en el entorno):
# MODEL_PROVIDER=bedrock
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=<id del perfil de inferencia de un modelo con tool use, habilitado en tu cuenta>
# BEDROCK_GUARDRAIL_ID=<terraform output assistant.guardrail_id>
# BEDROCK_GUARDRAIL_VERSION=<terraform output assistant.guardrail_version>
