# Copia este archivo a .env y ajusta los valores.
NODE_ENV=development
# local | dev | staging | prod. Fuera de local se exige Cognito y TLS hacia la base.
APP_ENV=local
PORT=3000
# DB_AUTH=url (local) | password (tarea de migraciones) | iam (servicio en ECS)
DB_AUTH=url
DATABASE_URL=postgres://ambar:ambar_local@localhost:5432/ambar
MIGRATE_ON_START=true

# local: tokens HS256 generados con `npm run token`. En AWS: AUTH_MODE=cognito.
AUTH_MODE=local
LOCAL_JWT_SECRET=cambia-este-secreto-local-de-32-caracteres-o-mas

# Solo AUTH_MODE=cognito
# COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX
# COGNITO_CLIENT_IDS=xxxxxxxxxxxxxxxxxxxxxxxxxx
SCOPE_PREFIX=ambar-api/
# ledger.admin además exige que el usuario pertenezca a este grupo de Cognito.
ADMIN_GROUP=operators

# Habilita POST /v1/qa/deposits. Nunca en producción (la configuración lo impide).
ENABLE_QA_ENDPOINTS=true
