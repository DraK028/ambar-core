{
  "name": "@ambar/ledger",
  "version": "0.1.0",
  "private": true,
  "description": "Servicio Ledger de Ámbar: asientos de doble partida, saldos y transferencias internas",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "migrate": "tsx src/infrastructure/migrate.cli.ts",
    "reconcile": "tsx src/scripts/reconcile.ts",
    "token": "tsx src/scripts/mint-dev-token.ts",
    "seed": "tsx src/scripts/seed.ts",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration e2e --runInBand",
    "test:cov": "jest --coverage",
    "relay": "tsx src/relay/main.ts"
  },
  "dependencies": {
    "@ambar/events": "*",
    "@aws-sdk/client-eventbridge": "^3.1152.0",
    "@aws-sdk/rds-signer": "^3.1152.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "jose": "^5.10.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@ambar/api-contract": "*",
    "@nestjs/testing": "^11.2.7",
    "@testcontainers/postgresql": "^11.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^7.2.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "jest": "^29.7.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "yaml": "^2.8.0"
  }
}
