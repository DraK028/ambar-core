{
  "name": "@ambar/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "App móvil de Ámbar: login biométrico con llave de hardware y confirmación de transferencias",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "bundle:check": "expo export --platform android --platform ios --output-dir .export-check && rm -rf .export-check",
    "e2e:android": "sh e2e/run-android.sh"
  },
  "dependencies": {
    "@ambar/api-client": "*",
    "@ambar/banking-rules": "*",
    "expo": "~57.0.25",
    "expo-auth-session": "~57.0.13",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-local-authentication": "~57.0.3",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.23",
    "expo-screen-capture": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.3.0",
    "react-native": "0.87.1",
    "react-native-safe-area-context": "~5.10.0",
    "react-native-screens": "~4.28.0",
    "react-native-ssl-public-key-pinning": "^1.2.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "~19.3.0",
    "jose": "^5.10.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
