# --- Local (sin AWS): Ledger en tu máquina + servidor de tokens de desarrollo ---
# Con un emulador de Android, expón los puertos:  adb reverse tcp:3000 tcp:3000 && adb reverse tcp:8787 tcp:8787 && adb reverse tcp:3002 tcp:3002
EXPO_PUBLIC_AUTH_MODE=local
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_DEV_AUTH_URL=http://localhost:8787
# Asistente local (services/assistant). En AWS no hace falta: usa EXPO_PUBLIC_API_URL.
EXPO_PUBLIC_ASSISTANT_URL=http://localhost:3002

# --- Dev en AWS (valores de `terraform output cognito` y `terraform output api_url`) ---
# EXPO_PUBLIC_AUTH_MODE=cognito
# EXPO_PUBLIC_API_URL=https://api.ambar.midominio.com
# EXPO_PUBLIC_COGNITO_DOMAIN=https://ambar-dev-xxxxxx.auth.us-east-1.amazoncognito.com
# EXPO_PUBLIC_COGNITO_CLIENT_ID=<client_ids.mobile>

# --- Certificate pinning (opcional, solo con dominio propio) ---
# Se fija la llave de las CA raíz de Amazon (ACM rota las llaves del certificado hoja al renovar).
# Verifica cada hash antes de usarlo:
#   openssl s_client -connect api.ambar.midominio.com:443 -showcerts </dev/null \
#     | openssl x509 -pubkey -noout | openssl pkey -pubin -outform der | openssl dgst -sha256 -binary | base64
# EXPO_PUBLIC_PINNED_DOMAIN=api.ambar.midominio.com
# EXPO_PUBLIC_PIN_HASHES=<hash1>,<hash2>

# --- Notificaciones push (opcional) ---
# Proyecto de EAS (eas init). Sin esta variable la app funciona igual, solo sin push:
# los avisos siguen en la pestaña Avisos. En Android además hace falta google-services.json (FCM).
# EXPO_PUBLIC_EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000
